# ── AI / LLM ──────────────────────────────────────────────────────────────────
# Google Gemini API key for AI-powered answers (RAG synthesis)
# Get yours free at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Authentication ────────────────────────────────────────────────────────────
# Strong random secret for JWT signing — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-strong-random-secret

# ── Upload Settings ───────────────────────────────────────────────────────────
# Maximum upload file size in megabytes (default: 25)
MAX_UPLOAD_MB=25

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# In production on HuggingFace Spaces, this is not needed (same-origin)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── OCR (Windows local development only) ─────────────────────────────────────
# These are auto-detected on Linux/Docker. Only set if needed on Windows.
# TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
# POPPLER_PATH=C:\poppler\poppler-26.02.0\Library\bin

# ── RAG Settings ─────────────────────────────────────────────────────────────
# Number of chunks to retrieve per query (default: 5)
TOP_K_RESULTS=5
# Embedding model from sentence-transformers hub
EMBEDDING_MODEL=all-MiniLM-L6-v2
