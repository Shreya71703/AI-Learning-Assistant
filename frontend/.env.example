# Frontend environment variables for local development.
# Copy this file to .env and fill in values.
# Variables prefixed with VITE_ are exposed to the browser bundle.

# Backend port for the Vite dev proxy (default: 8001)
VITE_BACKEND_PORT=8001

# Optional: point to a remote backend instead of using the local proxy
# VITE_API_URL=https://your-backend.onrender.com
